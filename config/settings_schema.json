  {
    "name": "t:settings.brand.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.brand.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "label": "t:settings.brand.logo_width",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.brand.favicon"
      },
      {
        "type": "textarea",
        "id": "brand_tagline",
        "label": "t:settings.brand.tagline",
        "default": "Shoes built for little adventurers."
      }
    ]
  },
