  {
    "name": "t:settings.typography.name",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "t:settings.typography.heading",
        "default": "poppins_n6"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "t:settings.typography.body",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_body_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "t:settings.typography.body_scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "font_heading_scale",
        "min": 90,
        "max": 140,
        "step": 5,
        "unit": "%",
        "label": "t:settings.typography.heading_scale",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "t:settings.typography.heading_uppercase",
        "default": false
      }
    ]
  },
  {
    "name": "t:settings.shape.name",
    "settings": [
      {
        "type": "range",
        "id": "radius_card",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "t:settings.shape.radius_card",
        "default": 20
      },
      {
        "type": "range",
        "id": "radius_button",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "t:settings.shape.radius_button",
        "default": 40
      },
      {
        "type": "range",
        "id": "radius_input",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "t:settings.shape.radius_input",
        "default": 12
      },
      {
        "type": "select",
        "id": "card_shadow",
        "label": "t:settings.shape.card_shadow",
        "options": [
          { "value": "none", "label": "t:settings.shape.shadow_none" },
          { "value": "soft", "label": "t:settings.shape.shadow_soft" },
          { "value": "pop", "label": "t:settings.shape.shadow_pop" }
        ],
        "default": "soft"
      },
      {
        "type": "checkbox",
        "id": "enable_blobs",
        "label": "t:settings.shape.enable_blobs",
        "info": "t:settings.shape.enable_blobs_info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings.product_card.name",
    "settings": [
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "t:settings.product_card.image_ratio",
        "options": [
          { "value": "square", "label": "t:settings.product_card.ratio_square" },
          { "value": "portrait", "label": "t:settings.product_card.ratio_portrait" },
          { "value": "landscape", "label": "t:settings.product_card.ratio_landscape" }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "t:settings.product_card.hover_image",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_vendor",
        "label": "t:settings.product_card.show_vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_swatches",
        "label": "t:settings.product_card.show_swatches",
        "info": "t:settings.product_card.show_swatches_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "t:settings.product_card.quick_add",
        "info": "t:settings.product_card.quick_add_info",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_sizes",
        "label": "t:settings.product_card.show_sizes",
        "info": "t:settings.product_card.show_sizes_info",
        "default": true
      },
      {
        "type": "text",
        "id": "size_option_names",
        "label": "t:settings.product_card.size_option_names",
        "info": "t:settings.product_card.size_option_names_info",
        "default": "Size, UK Size, EU Size"
      },
      {
        "type": "text",
        "id": "color_option_names",
        "label": "t:settings.product_card.color_option_names",
        "default": "Color, Colour, Shade"
      }
    ]
  },
  {
    "name": "t:settings.cart.name",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "t:settings.cart.type",
        "options": [
          { "value": "drawer", "label": "t:settings.cart.type_drawer" },
          { "value": "page", "label": "t:settings.cart.type_page" }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "t:settings.cart.show_note",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_bar",
        "label": "t:settings.cart.free_shipping_bar",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "t:settings.cart.free_shipping_threshold",
        "info": "t:settings.cart.free_shipping_threshold_info",
        "default": 999
      }
    ]
  },
  {
    "name": "t:settings.sizing.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings.sizing.intro"
      },
      {
        "type": "checkbox",
        "id": "enable_size_guide",
        "label": "t:settings.sizing.enable",
        "default": true
      },
      {
        "type": "textarea",
        "id": "size_chart_rows",
        "label": "t:settings.sizing.rows",
        "info": "t:settings.sizing.rows_info",
        "default": "21 | 12.8 | 1 - 1.5 yrs\n22 | 13.5 | 1.5 - 2 yrs\n23 | 14.2 | 2 - 2.5 yrs\n24 | 14.9 | 2.5 - 3 yrs\n25 | 15.6 | 3 - 3.5 yrs\n26 | 16.3 | 3.5 - 4 yrs\n27 | 17.0 | 4 - 4.5 yrs\n28 | 17.7 | 4.5 - 5 yrs\n29 | 18.4 | 5 - 6 yrs\n30 | 19.1 | 6 - 7 yrs\n31 | 19.8 | 7 - 8 yrs\n32 | 20.5 | 8 - 9 yrs\n33 | 21.2 | 9 - 10 yrs\n34 | 21.9 | 10 - 11 yrs"
      },
      {
        "type": "textarea",
        "id": "size_guide_tips",
        "label": "t:settings.sizing.tips",
        "info": "t:settings.sizing.tips_info",
        "default": "Measure in the evening, when feet are at their largest.\nStand your child on paper, mark heel and longest toe, then measure the gap.\nAdd 0.5 cm of growing room and pick the closest size up.\nStill between sizes? Always go up — kids grow fast."
      }
    ]
  },
  {
