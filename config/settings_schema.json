[
  {
    "name": "theme_info",
    "theme_name": "Hopits",
    "theme_author": "Hopits",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://www.hopits.com",
    "theme_support_url": "https://www.hopits.com/pages/contact"
