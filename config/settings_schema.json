        "info": "https://instagram.com/shophopits"
      },
      { "type": "text", "id": "social_facebook", "label": "Facebook" },
      { "type": "text", "id": "social_youtube", "label": "YouTube" },
      { "type": "text", "id": "social_pinterest", "label": "Pinterest" },
      {
        "type": "header",
        "content": "t:settings.social.support"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "t:settings.social.whatsapp",
        "info": "t:settings.social.whatsapp_info"
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "t:settings.social.whatsapp_message",
