{%- comment -%}
  Category tiles. Either a wrapping grid or a carousel showing a fractional
  number of cards, so a half card peeks at the edge and makes it obvious the
  row scrolls without needing arrows to say so.
{%- endcomment -%}
{%- liquid
  assign tile_layout = section.settings.tile_layout | default: 'carousel'
  assign tile_style = section.settings.tile_style | default: 'blob'
-%}

{%- capture tile_items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign tile_collection = collections[block.settings.collection]
      assign tile_url = tile_collection.url | default: block.settings.link | default: '#'
      assign tile_heading = block.settings.heading | default: tile_collection.title

      assign shape_cycle = 'pebble,arch,petal,cloud,squircle' | split: ','
      assign shape_index = forloop.index0 | modulo: 5
      assign section_shape = section.settings.blob_shape | default: 'arch'
      if section_shape == 'cycle'
        assign blob_shape = shape_cycle[shape_index]
      else
        assign blob_shape = section_shape
      endif
      if block.settings.shape != blank
        assign blob_shape = block.settings.shape
      endif
      assign color_index = forloop.index0 | modulo: 5
    -%}

    {%- if tile_style == 'blob' -%}
      <a href="{{ tile_url }}" class="blob-tile" {{ block.shopify_attributes }}>
        <span
          class="blob-tile__shape blob-tile__shape--{{ blob_shape }} blob-tile__shape--c{{ color_index }}"
          {% if block.settings.background_color != blank %}style="background: {{ block.settings.background_color }};"{% endif %}
        >
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ tile_heading | escape }}" loading="lazy" width="600" height="600">
          {%- elsif tile_collection.featured_image -%}
            <img src="{{ tile_collection.featured_image | image_url: width: 600 }}" alt="{{ tile_collection.title | escape }}" loading="lazy" width="600" height="600">
          {%- endif -%}
        </span>
        <span class="blob-tile__title">{{ tile_heading | escape }}</span>
        {%- if section.settings.show_counts and tile_collection != blank -%}
          <span class="blob-tile__count">{{ 'products.facets.product_count' | t: count: tile_collection.all_products_count }}</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <a href="{{ tile_url }}" class="tile" {{ block.shopify_attributes }}>
        <span class="tile__media media">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ tile_heading | escape }}" loading="lazy" width="700" height="933">
          {%- elsif tile_collection.featured_image -%}
            <img src="{{ tile_collection.featured_image | image_url: width: 700 }}" alt="{{ tile_collection.title | escape }}" loading="lazy" width="700" height="933">
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </span>
        <span class="tile__overlay">
          <span class="tile__title">{{ tile_heading | escape }}</span>
          {%- if section.settings.show_counts and tile_collection != blank -%}
            <span class="tile__count">{{ 'products.facets.product_count' | t: count: tile_collection.all_products_count }}</span>
          {%- endif -%}
        </span>
      </a>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width">
    <div class="section-header{% if section.settings.align == 'center' %} section-header--center{% endif %}">
      <div class="section-header__text">
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      <div class="section-header__tools">
        {%- if tile_layout == 'carousel' -%}
          <div class="carousel-nav">
            <button type="button" class="carousel-nav__btn" data-carousel-prev aria-label="{{ 'general.accessibility.previous' | t }}">
              {% render 'icon', icon: 'chevron-right' %}
            </button>
            <button type="button" class="carousel-nav__btn" data-carousel-next aria-label="{{ 'general.accessibility.next' | t }}">
              {% render 'icon', icon: 'chevron-right' %}
            </button>
          </div>
        {%- endif -%}
        {%- if section.settings.link_label != blank -%}
          <a href="{{ section.settings.link }}" class="button button--ghost">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if tile_layout == 'carousel' -%}
      <div
        class="cat-carousel"
        data-carousel
        style="--cols-d: {{ section.settings.cards_desktop }}; --cols-m: {{ section.settings.cards_mobile }};"
      >
        <div class="scroller scroller--cols" data-scroller>{{ tile_items }}</div>
        <div class="scroll-progress" data-scroll-progress aria-hidden="true">
          <span class="scroll-progress__thumb" data-scroll-thumb></span>
        </div>
      </div>
    {%- elsif tile_style == 'blob' -%}
      <div class="blob-grid blob-grid--{{ section.settings.columns }}">{{ tile_items }}</div>
    {%- else -%}
      <div class="tile-grid tile-grid--{{ section.settings.columns }}">{{ tile_items }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection tiles",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "tile_layout",
      "label": "Layout",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "cards_desktop",
      "min": 2,
      "max": 7,
      "step": 0.5,
      "label": "Cards per view, desktop",
      "info": "A half card showing at the edge makes it obvious the row scrolls.",
      "default": 4.5
    },
    {
      "type": "range",
      "id": "cards_mobile",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "label": "Cards per view, phone",
      "default": 2.5
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "info": "Grid layout only.",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "tile_style",
      "label": "Tile style",
      "options": [
        { "value": "blob", "label": "Blob — masked shape on colour, label below" },
        { "value": "card", "label": "Card — full-bleed image, label overlaid" }
      ],
      "default": "blob"
    },
    {
      "type": "select",
      "id": "blob_shape",
      "label": "Blob shape",
      "info": "Blob style only. One shape across the row reads as a set.",
      "options": [
        { "value": "arch", "label": "Arch — oval top, flat bottom" },
        { "value": "pebble", "label": "Pebble" },
        { "value": "petal", "label": "Petal" },
        { "value": "cloud", "label": "Cloud" },
        { "value": "squircle", "label": "Squircle" },
        { "value": "cycle", "label": "Cycle through all five" }
      ],
      "default": "arch"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "checkbox", "id": "show_counts", "label": "Show product counts", "default": true },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no collection is chosen." },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "heading", "label": "Heading override" },
        {
          "type": "select",
          "id": "shape",
          "label": "Blob shape",
          "info": "Overrides the section shape for this tile only.",
          "options": [
            { "value": "", "label": "Use section shape" },
            { "value": "pebble", "label": "Pebble" },
            { "value": "arch", "label": "Arch" },
            { "value": "petal", "label": "Petal" },
            { "value": "cloud", "label": "Cloud" },
            { "value": "squircle", "label": "Squircle" }
          ],
          "default": ""
        },
        { "type": "color", "id": "background_color", "label": "Background colour", "info": "Blob style only. Leave empty to cycle." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
