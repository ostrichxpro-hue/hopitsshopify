<div class="page-width page-width--narrow section">
  <h2 class="h2 text-center">{{ section.settings.heading | default: 'Get in touch' | escape }}</h2>

  {%- form 'contact', class: 'stack stack-4 mt-8' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-status form-status--success">{{ 'contact.form.success' | t }}</div>
    {%- elsif form.errors -%}
      <div class="form-status form-status--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
      <input type="text" id="ContactName" name="contact[name]" class="field__input" autocomplete="name" required>
    </div>
    <div class="field">
      <label class="field__label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
      <input type="email" id="ContactEmail" name="contact[email]" class="field__input" autocomplete="email" required>
    </div>
    <div class="field">
      <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
      <input type="tel" id="ContactPhone" name="contact[phone]" class="field__input" autocomplete="tel">
    </div>
    <div class="field">
      <label class="field__label" for="ContactBody">{{ 'contact.form.message' | t }}</label>
      <textarea id="ContactBody" name="contact[body]" class="field__input" rows="6" required></textarea>
    </div>

    <button type="submit" class="button button--primary">{{ 'contact.form.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch" }],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
