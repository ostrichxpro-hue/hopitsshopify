{%- liquid
  assign featured = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="badge badge--best">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="section-header__title h2 mt-4">{{ section.settings.heading | default: featured.title | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if featured != blank -%}
        <a href="{{ featured.url }}" class="button button--ghost">
          {{ section.settings.link_label | default: 'View all' | escape }}
        </a>
      {%- endif -%}
    </div>

    {%- if featured.products.size > 0 -%}
      <ul class="{% if section.settings.layout == 'scroll' %}scroller{% else %}product-grid product-grid--{{ section.settings.columns }}{% endif %}">
        {%- for product in featured.products limit: limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="product-grid product-grid--{{ section.settings.columns }}">
        {%- for i in (1..4) -%}
          <li>
            <div class="product-card">
              <div class="product-card__media-wrap">
                <span class="media media--square">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span>
              </div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
                <div class="price"><span class="price__regular">{{ 1999 | times: 100 | money }}</span></div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow badge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
