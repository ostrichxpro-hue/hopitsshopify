{%- comment -%}
  Social strip. Images are merchant-uploaded rather than pulled from a feed, so
  there is no third-party script, no API token to expire, and nothing blocking
  render.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- liquid
      assign image_ratio = section.settings.image_ratio | default: 'portrait'
      if image_ratio == 'square'
        assign ratio_w = 1080
        assign ratio_h = 1080
        assign ratio_h_270 = 270
        assign ratio_h_540 = 540
        assign ratio_h_810 = 810
      else
        comment
          Instagram's portrait post: 1080x1350, a 4:5 frame.
        endcomment
        assign ratio_w = 1080
        assign ratio_h = 1350
        assign ratio_h_270 = 338
        assign ratio_h_540 = 675
        assign ratio_h_810 = 1013
      endif
    -%}

    <div class="follow-grid follow-grid--{{ image_ratio }}">
      {%- for block in section.blocks -%}
        {%- assign tile_link = block.settings.link | default: section.settings.profile_url -%}
        <a
          class="follow-tile"
          href="{{ tile_link | default: '#' }}"
          {% if tile_link != blank %}target="_blank" rel="noopener"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {%- comment -%}
              Passing both width and height makes Shopify crop to the ratio, so
              a square or landscape upload still fills the tile instead of
              letterboxing. Instagram's native portrait post is 1080x1350.
            {%- endcomment -%}
            <img
              src="{{ block.settings.image | image_url: width: 540, height: ratio_h_540, crop: 'center' }}"
              srcset="
                {{ block.settings.image | image_url: width: 270, height: ratio_h_270, crop: 'center' }} 270w,
                {{ block.settings.image | image_url: width: 540, height: ratio_h_540, crop: 'center' }} 540w,
                {{ block.settings.image | image_url: width: 810, height: ratio_h_810, crop: 'center' }} 810w
              "
              sizes="(min-width: 990px) 16vw, (min-width: 600px) 31vw, 46vw"
              alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
              width="{{ ratio_w }}"
              height="{{ ratio_h }}"
              loading="lazy"
            >
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="follow-tile__icon" aria-hidden="true">{% render 'icon', icon: 'instagram' %}</span>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank and section.settings.profile_url != blank -%}
      <div class="text-center mt-8">
        <a href="{{ section.settings.profile_url }}" target="_blank" rel="noopener" class="button button--secondary">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Follow us",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Follow us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@hopits" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tag us in your little one's adventures." },
    { "type": "url", "id": "profile_url", "label": "Profile link" },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "info": "Portrait matches Instagram's 1080x1350 post. Uploads are cropped to fit either way.",
      "options": [
        { "value": "portrait", "label": "Portrait 4:5 (1080x1350)" },
        { "value": "square", "label": "Square 1:1 (1080x1080)" }
      ],
      "default": "portrait"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the profile link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Follow us",
      "blocks": [
        { "type": "post" }, { "type": "post" }, { "type": "post" },
        { "type": "post" }, { "type": "post" }, { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
