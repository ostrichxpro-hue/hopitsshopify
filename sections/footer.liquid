<footer class="footer">
  <div class="page-width">
    <div class="footer__grid">
      <div>
        <div class="footer__logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name | escape }}" loading="lazy" width="140" height="40" style="filter: brightness(0) invert(1)">
          {%- else -%}
            <span class="header__logo-text" style="color:#fff">{{ shop.name }}</span>
          {%- endif -%}
        </div>

        {%- if settings.brand_tagline != blank -%}
          <p class="footer__tagline">{{ settings.brand_tagline | escape }}</p>
        {%- endif -%}

        <div class="social-row">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon', icon: 'youtube' %}</a>
          {%- endif -%}
          {%- if settings.social_pinterest != blank -%}
            <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'icon', icon: 'pinterest' %}</a>
          {%- endif -%}
        </div>

        {%- if settings.support_email != blank or settings.support_phone != blank -%}
          <ul class="footer__list mt-6">
            {%- if settings.support_email != blank -%}
              <li><a href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a></li>
            {%- endif -%}
            {%- if settings.support_phone != blank -%}
              <li><a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'text' -%}
            <div {{ block.shopify_attributes }}>
              <h2 class="footer__heading">{{ block.settings.heading | escape }}</h2>
              <div class="rte" style="font-size:1.45rem">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="payment-icons" aria-label="{{ 'sections.footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Made for little adventurers.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } },
      { "type": "menu", "settings": { "heading": "Company" } }
    ]
  }
}
{% endschema %}
