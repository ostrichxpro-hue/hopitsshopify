<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="split{% if section.settings.media_position == 'right' %} split--reverse{% endif %}">
      <div class="split__media">
        {%- if section.settings.image != blank -%}
          <span class="media media--landscape">
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              srcset="{{ section.settings.image | image_url: width: 500 }} 500w, {{ section.settings.image | image_url: width: 1000 }} 1000w"
              sizes="(min-width: 750px) 50vw, 100vw"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              loading="lazy"
              width="{{ section.settings.image.width }}"
              height="{{ section.settings.image.height }}"
            >
          </span>
        {%- else -%}
          <span class="media media--landscape">{{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}</span>
        {%- endif -%}
      </div>

      <div class="split__body">
        {%- if section.settings.eyebrow != blank -%}
          <span class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-muted">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="feature-list">
            {%- for block in section.blocks -%}
              <li class="feature-list__item" {{ block.shopify_attributes }}>
                <span class="feature-list__icon">{% render 'icon', icon: block.settings.icon %}</span>
                <span>
                  <span class="feature-list__title" style="display:block">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="feature-list__text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="button button--primary mt-8">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for growing feet" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Every pair is designed around how kids actually move — and how fast they outgrow things.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "foot", "label": "Fit" },
            { "value": "shield", "label": "Quality" },
            { "value": "heart", "label": "Care" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "ruler", "label": "Sizing" },
            { "value": "truck", "label": "Delivery" }
          ],
          "default": "foot"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Flexible soles" },
        { "type": "text", "id": "text", "label": "Text", "default": "Bend where little feet bend." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [{ "type": "feature" }, { "type": "feature" }, { "type": "feature" }]
    }
  ]
}
{% endschema %}
