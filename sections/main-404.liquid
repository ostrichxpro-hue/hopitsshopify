<div class="page-width error-page">
  <div class="error-page__code">404</div>
  <h1 class="h2">{{ 'errors.404.title' | t }}</h1>
  <p class="text-muted" style="max-width:44rem">{{ 'errors.404.subtext' | t }}</p>
  <a href="{{ routes.all_products_collection_url }}" class="button button--primary button--large">
    {{ 'errors.404.cta' | t }}
  </a>
</div>

{% schema %}
{ "name": "404" }
{% endschema %}
