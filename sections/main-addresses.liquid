<div class="page-width section">
  <a href="{{ routes.account_url }}" class="button button--ghost">{{ 'customer.account.return' | t }}</a>
  <h1 class="h3 mt-6">{{ 'customer.addresses.title' | t }}</h1>

  {%- paginate customer.addresses by 10 -%}
    <div class="card mt-8" style="padding:2.4rem;background:var(--hp-surface)">
      <h2 class="h5">{{ 'customer.addresses.add_new' | t }}</h2>

      {%- form 'customer_address', customer.new_address, class: 'stack stack-4 mt-6' -%}
        {% render 'address-fields', form: form %}
        <label class="facet__option">
          {{ form.set_as_default_checkbox }}
          <span>{{ 'customer.addresses.set_default' | t }}</span>
        </label>
        <button type="submit" class="button button--primary">{{ 'customer.addresses.save' | t }}</button>
      {%- endform -%}
    </div>

    {%- if customer.addresses.size > 0 -%}
      <div class="tile-grid tile-grid--3 mt-8" style="align-items:start">
        {%- for address in customer.addresses -%}
          <div class="card" style="padding:2rem;border:2px solid var(--hp-border)">
            {%- if address == customer.default_address -%}
              <span class="badge badge--new">{{ 'customer.addresses.default' | t }}</span>
            {%- endif -%}
            <div class="text-muted mt-4">{{ address | format_address }}</div>

            <details class="mt-4">
              <summary style="cursor:pointer;font-weight:600;font-size:1.4rem">{{ 'customer.addresses.edit' | t }}</summary>
              {%- form 'customer_address', address, class: 'stack stack-4 mt-4' -%}
                {% render 'address-fields', form: form %}
                <label class="facet__option">
                  {{ form.set_as_default_checkbox }}
                  <span>{{ 'customer.addresses.set_default' | t }}</span>
                </label>
                <button type="submit" class="button button--primary button--small">{{ 'customer.addresses.save' | t }}</button>
              {%- endform -%}
            </details>

            <button
              type="button"
              class="cart-item__remove mt-4"
              onclick="if (confirm('{{ 'customer.addresses.delete_confirm' | t }}')) { Shopify.postLink('{{ address.url }}', { parameters: { _method: 'delete' } }); }"
            >
              {{ 'customer.addresses.delete' | t }}
            </button>
          </div>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="text-muted mt-8">{{ 'customer.addresses.none' | t }}</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Addresses" }
{% endschema %}

<script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer="defer"></script>
<script>
  window.addEventListener('load', function () {
    document.querySelectorAll('[data-address-country]').forEach(function (select) {
      var wrap = select.closest('form');
      var province = wrap && wrap.querySelector('[data-address-province]');
      var provinceWrap = wrap && wrap.querySelector('[data-address-province-wrap]');
      if (!province || !window.Shopify || !Shopify.CountryProvinceSelector) return;
      new Shopify.CountryProvinceSelector(select.id, province.id, { hideElement: provinceWrap.id || undefined });
      if (!provinceWrap.id) {
        // The helper hides by id; fall back to toggling the wrapper ourselves.
        var sync = function () {
          provinceWrap.hidden = province.options.length === 0;
        };
        select.addEventListener('change', sync);
        sync();
      }
    });
  });
</script>
