{%- paginate blog.articles by 12 -%}
  <div class="collection-hero">
    <span class="blob blob--1"></span>
    <div class="page-width" style="position:relative;z-index:1">
      <h1 class="h1">{{ blog.title | escape }}</h1>
    </div>
  </div>

  <div class="page-width section">
    {%- if blog.articles.size > 0 -%}
      <div class="article-grid">
        {%- for article in blog.articles -%}
          <article>
            {%- if article.image -%}
              <a href="{{ article.url }}" class="article-card__media media" tabindex="-1" aria-hidden="true">
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="700" height="525">
              </a>
            {%- endif -%}
            <h2 class="article-card__title h4"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
            <div class="article-card__meta">
              {{ article.published_at | date: format: 'date' }}
              {%- if article.author != blank %} &middot; {{ 'blogs.article.by_author' | t: author: article.author }}{% endif -%}
            </div>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 26 }}</p>
          </article>
        {%- endfor -%}
      </div>

      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog posts" }
{% endschema %}
