<div class="hero" style="min-height:100vh;display:grid;place-items:center">
  <span class="blob blob--1"></span>
  <span class="blob blob--2"></span>

  <div class="page-width page-width--narrow text-center" style="position:relative;z-index:1;padding-block:6.4rem">
    {%- if settings.logo != blank -%}
      <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="180" height="50" style="margin-inline:auto;width:180px">
    {%- else -%}
      <h1 class="h1">{{ shop.name }}</h1>
    {%- endif -%}

    <h2 class="h2 mt-8">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte text-muted">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'newsletter__form', style: 'background:none' -%}
      <div class="field">
        <label class="visually-hidden" for="PasswordInput">Password</label>
        <input type="password" id="PasswordInput" name="password" class="field__input" placeholder="Enter store password" autocomplete="current-password">
      </div>
      <button type="submit" class="button button--primary">Enter</button>
      {%- if form.errors -%}
        <div class="form-status form-status--error full-width">{{ form.errors.messages.form }}</div>
      {%- endif -%}
    {%- endform -%}

    <p class="text-muted mt-8" style="font-size:1.35rem">
      Are you the store owner?
      <a href="/admin">Log in here</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something brilliant is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're putting the finishing touches on the new Hopits store.</p>" }
  ]
}
{% endschema %}
