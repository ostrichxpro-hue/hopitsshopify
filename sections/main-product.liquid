{%- liquid
  assign current_variant = product.selected_or_first_available_variant

  comment
    Identify which option holds the size so we can attach the size guide to it.
  endcomment
  assign size_index = -1
  assign size_names = settings.size_option_names | downcase | split: ','
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for candidate in size_names
      assign candidate_name = candidate | strip
      if option_name == candidate_name and size_index == -1
        assign size_index = forloop.parentloop.index0
      endif
    endfor
  endfor

  assign color_index = -1
  assign color_names = settings.color_option_names | downcase | split: ','
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    for candidate in color_names
      assign candidate_name = candidate | strip
      if option_name == candidate_name and color_index == -1
        assign color_index = forloop.parentloop.index0
      endif
    endfor
  endfor

  assign low_stock_at = section.settings.low_stock_threshold
-%}

<div class="page-width">
  {% render 'breadcrumbs' %}
</div>

<div class="page-width">
  <div class="product" data-variant-picker>
    {%- comment -%} Gallery {%- endcomment -%}
    <div class="gallery" data-gallery>
      <div class="gallery__main">
        <div class="gallery__badges">
          {%- unless product.available -%}
            <span class="badge badge--soldout">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif current_variant.compare_at_price > current_variant.price -%}
            {%- assign saved = current_variant.compare_at_price | minus: current_variant.price -%}
            {%- assign pct = saved | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="badge badge--sale">{{ pct }}% off</span>
          {%- endunless -%}
        </div>

        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="gallery__slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide>
              <span class="media media--square">
                <img
                  src="{{ media.preview_image | image_url: width: 1200 }}"
                  srcset="{{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 1200 }} 1200w, {{ media.preview_image | image_url: width: 1800 }} 1800w"
                  sizes="(min-width: 990px) 55vw, 100vw"
                  alt="{{ media.alt | escape }}"
                  width="{{ media.preview_image.width }}"
                  height="{{ media.preview_image.height }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >
              </span>
            </div>
          {%- endfor -%}
        {%- else -%}
          <span class="media media--square">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</span>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs">
          {%- for media in product.media -%}
            <li>
              <button
                type="button"
                class="gallery__thumb"
                data-gallery-thumb
                data-media-id="{{ media.id }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'general.accessibility.previous' | t }} {{ forloop.index }}"
              >
                <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" loading="lazy" width="70" height="70">
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} Details {%- endcomment -%}
    <div class="product__details">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'vendor' -%}
            {%- if product.vendor != blank -%}
              <div class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</div>
            {%- endif -%}

          {%- when 'title' -%}
            <h1 class="product__title h2" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              <div class="product__price-row" data-price-target>
                {% render 'price', variant: current_variant, class: 'price--large', show_save: true %}
              </div>
              <div class="product__tax-note">{{ 'products.product.inclusive_of_tax' | t }}</div>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div {{ block.shopify_attributes }}>
                {%- for option in product.options_with_values -%}
                  {%- assign option_index = forloop.index0 -%}
                  {%- assign is_color = false -%}
                  {%- if option_index == color_index %}{% assign is_color = true %}{% endif -%}

                  <div class="variant-group">
                    <div class="variant-group__header">
                      <span class="variant-group__label">
                        {{ option.name }}
                        <span class="variant-group__value">{{ option.selected_value }}</span>
                      </span>

                      {%- if option_index == size_index and settings.enable_size_guide -%}
                        <button type="button" class="variant-group__link" data-panel-open="SizeGuideModal">
                          {% render 'icon', icon: 'ruler' %}
                          {{ 'products.product.size_guide' | t }}
                        </button>
                      {%- endif -%}
                    </div>

                    <div class="variant-options">
                      {%- for value in option.values -%}
                        {%- assign input_id = 'Option-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          name="option-{{ option_index }}"
                          value="{{ value | escape }}"
                          data-option-input
                          data-option-index="{{ option_index }}"
                          {% if option.selected_value == value %}checked{% endif %}
                        >
                        <label
                          for="{{ input_id }}"
                          class="variant-option{% if is_color %} variant-option--swatch{% endif %}"
                          title="{{ value | escape }}"
                        >
                          {%- if is_color -%}
                            {% render 'swatch-inline', value: value %}
                            <span class="visually-hidden">{{ value }}</span>
                          {%- else -%}
                            {{ value }}
                          {%- endif -%}
                        </label>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endfor -%}
              </div>
            {%- endunless -%}

          {%- when 'stock' -%}
            <div
              class="stock-line{% unless current_variant.available %} stock-line--out{% endunless %}"
              data-stock-target
              data-in-text="{{ 'products.product.in_stock' | t | escape }}"
              data-low-text="{{ 'products.product.low_stock' | t: count: '[count]' | escape }}"
              data-out-text="{{ 'products.product.sold_out' | t | escape }}"
              {{ block.shopify_attributes }}
            >
              <span class="stock-line__dot"></span>
              <span data-stock-text>
                {%- if current_variant.available -%}
                  {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= low_stock_at -%}
                    {{ 'products.product.low_stock' | t: count: current_variant.inventory_quantity }}
                  {%- else -%}
                    {{ 'products.product.in_stock' | t }}
                  {%- endif -%}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </span>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="product__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, data-cart-form: true, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">

                <div class="product__buy-row">
                  {% render 'quantity-input', id: 'ProductQuantity', name: 'quantity', value: 1, min: 1 %}

                  <button
                    type="submit"
                    name="add"
                    class="button button--primary button--large full-width"
                    {% unless current_variant.available %}aria-disabled="true"{% endunless %}
                  >
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </button>
                </div>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'trust' -%}
            <div class="product__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.item_1 != blank -%}
                <div class="product__trust-item">{% render 'icon', icon: 'truck' %}<span>{{ block.settings.item_1 | escape }}</span></div>
              {%- endif -%}
              {%- if block.settings.item_2 != blank -%}
                <div class="product__trust-item">{% render 'icon', icon: 'return' %}<span>{{ block.settings.item_2 | escape }}</span></div>
              {%- endif -%}
              {%- if block.settings.item_3 != blank -%}
                <div class="product__trust-item">{% render 'icon', icon: 'rupee' %}<span>{{ block.settings.item_3 | escape }}</span></div>
              {%- endif -%}
              {%- if block.settings.item_4 != blank -%}
                <div class="product__trust-item">{% render 'icon', icon: 'shield' %}<span>{{ block.settings.item_4 | escape }}</span></div>
              {%- endif -%}
            </div>

          {%- when 'description' -%}
            <div class="mt-8" {{ block.shopify_attributes }}>
              <div class="accordion">
                <div class="accordion__item">
                  <h2 style="margin:0">
                    <button type="button" class="accordion__trigger" data-accordion-trigger aria-expanded="true" aria-controls="ProductDescription">
                      <span>{{ 'products.product.description' | t }}</span>
                      <span class="accordion__icon">{% render 'icon', icon: 'plus' %}</span>
                    </button>
                  </h2>
                  <div class="accordion__panel rte" id="ProductDescription">{{ product.description }}</div>
                </div>
              </div>
            </div>

          {%- when 'collapsible' -%}
            <div class="accordion" {{ block.shopify_attributes }}>
              <div class="accordion__item">
                <h2 style="margin:0">
                  <button
                    type="button"
                    class="accordion__trigger"
                    data-accordion-trigger
                    aria-expanded="false"
                    aria-controls="Collapsible-{{ block.id }}"
                  >
                    <span>{{ block.settings.heading | escape }}</span>
                    <span class="accordion__icon">{% render 'icon', icon: 'plus' %}</span>
                  </button>
                </h2>
                <div class="accordion__panel rte" id="Collapsible-{{ block.id }}" hidden>{{ block.settings.content }}</div>
              </div>
            </div>

          {%- when 'share' -%}
            <div class="product__meta" {{ block.shopify_attributes }}>
              {%- if current_variant.sku != blank -%}
                <span>{{ 'products.product.sku' | t }}: <span data-sku-target>{{ current_variant.sku }}</span></span>
              {%- endif -%}
              <button type="button" class="variant-group__link" data-share="{{ shop.url | append: product.url }}">
                {% render 'icon', icon: 'share' %}
                {{ 'general.share.label' | t }}
              </button>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  Variant data for the picker. price_html is pre-rendered so switching a variant
  never has to reimplement money formatting in JS.
{%- endcomment -%}
<script type="application/json" data-variant-json>
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "options": {{ variant.options | json }},
        "available": {{ variant.available | json }},
        "sku": {{ variant.sku | json }},
        "media_id": {{ variant.featured_media.id | default: 0 | json }},
        "inventory": {{ variant.inventory_quantity | default: 0 | json }},
        "low": {% if variant.inventory_management != blank and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock_at %}true{% else %}false{% endif %},
        "price_html": {% capture variant_price %}{% render 'price', variant: variant, class: 'price--large', show_save: true %}{% endcapture %}{{ variant_price | strip_newlines | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 1,
      "max": 25,
      "step": 1,
      "label": "Low stock threshold",
      "info": "Show an urgency message at or below this quantity.",
      "default": 5
    }
  ],
  "blocks": [
    { "type": "vendor", "name": "Vendor", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "stock", "name": "Stock status", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true }
      ]
    },
    {
      "type": "trust",
      "name": "Trust points",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "Point 1", "default": "Free shipping on orders above ₹999" },
        { "type": "text", "id": "item_2", "label": "Point 2", "default": "Free size exchange within 7 days" },
        { "type": "text", "id": "item_3", "label": "Point 3", "default": "Cash on delivery available" },
        { "type": "text", "id": "item_4", "label": "Point 4", "default": "Skin-friendly, non-toxic materials" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Dispatched in 24 hours. Free size exchange within 7 days of delivery.</p>" }
      ]
    },
    { "type": "share", "name": "SKU and share", "limit": 1 }
  ]
}
{% endschema %}
