<div class="page-width auth-layout">
  <div class="auth-card">
    <h1 class="h3 text-center">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer', class: 'stack stack-4 mt-6' -%}
      {{ form.errors | default_errors }}

      <div class="field">
        <label class="field__label" for="RegisterFirst">{{ 'customer.register.first_name' | t }}</label>
        <input type="text" id="RegisterFirst" name="customer[first_name]" class="field__input" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLast">{{ 'customer.register.last_name' | t }}</label>
        <input type="text" id="RegisterLast" name="customer[last_name]" class="field__input" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
        <input type="email" id="RegisterEmail" name="customer[email]" class="field__input" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
        <input type="password" id="RegisterPassword" name="customer[password]" class="field__input" autocomplete="new-password" required>
      </div>

      <button type="submit" class="button button--primary button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p class="text-center mt-6" style="font-size:1.4rem">
      {{ 'customer.register.has_account' | t }}
      <a href="{{ routes.account_login_url }}">{{ 'customer.login.submit' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{ "name": "Register" }
{% endschema %}
