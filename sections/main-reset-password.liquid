<div class="page-width auth-layout">
  <div class="auth-card">
    <h1 class="h4 text-center">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="text-muted text-center" style="font-size:1.4rem">{{ 'customer.reset_password.subtext' | t }}</p>

    {%- form 'reset_customer_password', class: 'stack stack-4 mt-6' -%}
      {{ form.errors | default_errors }}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" class="field__input" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" class="field__input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary button--full">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
