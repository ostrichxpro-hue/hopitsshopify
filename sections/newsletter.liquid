<div class="section">
  <div class="page-width">
    <div class="newsletter">
      <span class="blob blob--1"></span>
      <span class="blob blob--2"></span>

      <div style="position:relative;z-index:1">
        <h2 class="h2" style="color:inherit">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p style="max-width:46rem;margin-inline:auto">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="field">
            <label class="visually-hidden" for="NewsletterEmail">{{ 'general.newsletter.label' | t }}</label>
            <input
              type="email"
              id="NewsletterEmail"
              name="contact[email]"
              class="field__input"
              placeholder="{{ 'general.newsletter.placeholder' | t }}"
              autocomplete="email"
              required
            >
          </div>
          <button type="submit" class="button button--ink">{{ section.settings.button_label | default: 'Join the club' | escape }}</button>

          {%- if form.errors -%}
            <div class="form-status form-status--error full-width">{{ form.errors.messages.email }}</div>
          {%- elsif form.posted_successfully? -%}
            <div class="form-status form-status--success full-width">{{ 'general.newsletter.success' | t }}</div>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.disclaimer != blank -%}
          <p style="margin-top:1.4rem;font-size:1.3rem;opacity:.8">{{ section.settings.disclaimer | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get 10% off your first pair" },
    { "type": "text", "id": "text", "label": "Text", "default": "New drops, sizing tips and the odd surprise. No spam, promise." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Join the club" },
    { "type": "text", "id": "disclaimer", "label": "Disclaimer", "default": "Unsubscribe any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
