{%- comment -%}
  Full-width A+ content below the product. Renders only when the product
  actually carries the custom.a_plus_* images, so products without them show
  nothing rather than an empty band.
{%- endcomment -%}
{%- liquid
  assign has_aplus = false
  if product.metafields.custom.a_plus_1.value != blank or product.metafields.custom.a_plus_2.value != blank or product.metafields.custom.a_plus_3.value != blank
    assign has_aplus = true
  endif
-%}
{%- if has_aplus -%}
  <div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="section-header section-header--center">
          <div class="section-header__text">
            <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
          </div>
        </div>
      {%- endif -%}
      {% render 'product-aplus', product: product %}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "A+ content",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the images in the product's A Plus 1, 2 and 3 metafields. Hidden on products that have none."
    },
    { "type": "text", "id": "heading", "label": "Heading" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
