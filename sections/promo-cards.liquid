{%- comment -%}
  Row of full-bleed image cards: eyebrow and heading at the top, button at the
  bottom. Text colour is per block because these sit on photography — a light
  shot needs dark type and a dark one needs light.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="promo-row promo-row--{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <div class="promo-card promo-card--{{ block.settings.text_color }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img
              class="promo-card__bg"
              src="{{ block.settings.image | image_url: width: 800 }}"
              srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 750px) 33vw, 100vw"
              alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- endif -%}

          {%- if block.settings.scrim -%}
            <span class="promo-card__scrim" aria-hidden="true"></span>
          {%- endif -%}

          <div class="promo-card__body">
            <div>
              {%- if block.settings.eyebrow != blank -%}
                <span class="promo-card__eyebrow">{{ block.settings.eyebrow | escape }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="promo-card__title">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
            </div>

            {%- if block.settings.button_label != blank -%}
              <a
                href="{{ block.settings.button_link | default: '#' }}"
                class="button button--small promo-card__button {% if block.settings.button_style == 'primary' %}button--primary{% else %}button--light{% endif %}"
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo cards",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Spotlight" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Everyday sneakers" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select",
          "id": "text_color",
          "label": "Text colour",
          "info": "Light for dark photography, dark for pale photography.",
          "options": [
            { "value": "light", "label": "Light" },
            { "value": "dark", "label": "Dark" }
          ],
          "default": "light"
        },
        {
          "type": "checkbox",
          "id": "scrim",
          "label": "Darken image behind text",
          "info": "Keeps light text readable over a busy photo.",
          "default": true
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "light", "label": "White" },
            { "value": "primary", "label": "Brand green" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo cards",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
