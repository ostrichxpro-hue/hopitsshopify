<div class="section section--surface" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        <span class="squiggle">{% render 'icon', icon: 'squiggle' %}</span>
      </div>
    </div>

    {%- assign recommendations_limit = section.settings.products_to_show -%}

    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <ul class="product-grid product-grid--4">
        {%- for item in recommendations.products limit: recommendations_limit -%}
          <li>{% render 'product-card', product: item %}</li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      {%- assign fallback = product.collections.first -%}
      {%- if fallback.products.size > 1 -%}
        <ul class="product-grid product-grid--4">
          {%- assign shown = 0 -%}
          {%- for item in fallback.products -%}
            {%- if item.id != product.id and shown < recommendations_limit -%}
              <li>{% render 'product-card', product: item %}</li>
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "label": "Products to show", "default": 4 }
  ]
}
{% endschema %}
