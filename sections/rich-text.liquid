<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
  {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
{%- endif -%}
  <div class="page-width page-width--narrow text-center">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}
    <h2 class="h2">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}
      <div class="rte text-muted">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="button button--primary mt-6">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our promise" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Comfort first, always.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Decorative edge"
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Edge colour",
      "info": "Match the background of the section ABOVE this one.",
      "default": "#FFFFFF"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
