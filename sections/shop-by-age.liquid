<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  <div class="page-width">
    <div class="section-header section-header--center">
      <div class="section-header__text">
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        <span class="squiggle">{% render 'icon', icon: 'squiggle' %}</span>
      </div>
    </div>

    <div class="age-row">
      {%- for block in section.blocks -%}
        {%- assign block_collection = collections[block.settings.collection] -%}
        <a href="{{ block_collection.url | default: block.settings.link }}" class="age-bubble" {{ block.shopify_attributes }}>
          <span class="age-bubble__circle media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 500 }}"
                alt="{{ block.settings.label | escape }}"
                loading="lazy"
                width="500"
                height="500"
              >
            {%- elsif block_collection.featured_image -%}
              <img
                src="{{ block_collection.featured_image | image_url: width: 500 }}"
                alt="{{ block_collection.title | escape }}"
                loading="lazy"
                width="500"
                height="500"
              >
            {%- endif -%}
          </span>
          <span class="age-bubble__label">{{ block.settings.label | default: block_collection.title | escape }}</span>
          {%- if block.settings.sublabel != blank -%}
            <span class="age-bubble__sub">{{ block.settings.sublabel | escape }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by age",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by age" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Sized right for every stage, from first steps to school runs." },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age group",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link", "info": "Used when no collection is chosen." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Age 1-5" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "Sizes 21-27" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by age",
      "blocks": [
        { "type": "age", "settings": { "label": "Toddlers", "sublabel": "Sizes 21-25" } },
        { "type": "age", "settings": { "label": "Age 1-5", "sublabel": "Sizes 21-27" } },
        { "type": "age", "settings": { "label": "Age 3-9", "sublabel": "Sizes 26-32" } },
        { "type": "age", "settings": { "label": "Age 9-13", "sublabel": "Sizes 32-38" } }
      ]
    }
  ]
}
{% endschema %}
