{%- comment -%}
  Lifestyle image with product hotspots. Each dot is a real button carrying a
  product card, so it is keyboard reachable and the products stay linked for
  crawlers even before any script runs.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
          <span class="squiggle">{% render 'icon', icon: 'squiggle' %}</span>
        </div>
      </div>
    {%- endif -%}

    <div class="shoppable" data-shoppable>
      <div class="shoppable__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1600 }}"
            srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
            sizes="(min-width: 1100px) 1400px, 100vw"
            alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign hotspot_product = all_products[block.settings.product] -%}
          <div
            class="hotspot"
            style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%;"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="hotspot__dot"
              data-hotspot
              aria-expanded="false"
              aria-controls="Hotspot-{{ section.id }}-{{ forloop.index }}"
              aria-label="{{ hotspot_product.title | default: 'Product' | escape }}"
            >
              <span class="hotspot__pulse" aria-hidden="true"></span>
            </button>

            <div class="hotspot__pop" id="Hotspot-{{ section.id }}-{{ forloop.index }}" data-hotspot-pop hidden>
              {%- if hotspot_product != blank -%}
                <a href="{{ hotspot_product.url }}" class="hotspot__card">
                  {%- if hotspot_product.featured_media -%}
                    <img src="{{ hotspot_product.featured_media | image_url: width: 160 }}" alt="" width="64" height="64" loading="lazy">
                  {%- endif -%}
                  <span>
                    <span class="hotspot__title">{{ hotspot_product.title | escape }}</span>
                    <span class="hotspot__price">{{ hotspot_product.price | money }}</span>
                  </span>
                </a>
              {%- else -%}
                <p class="text-muted" style="margin:0;font-size:1.35rem">Pick a product for this hotspot.</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shoppable image",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Tap a dot to see what they are wearing." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "range", "id": "x", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Horizontal position", "default": 50 },
        { "type": "range", "id": "y", "min": 0, "max": 100, "step": 1, "unit": "%", "label": "Vertical position", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 30, "y": 55 } },
        { "type": "hotspot", "settings": { "x": 55, "y": 65 } },
        { "type": "hotspot", "settings": { "x": 75, "y": 50 } }
      ]
    }
  ]
}
{% endschema %}
