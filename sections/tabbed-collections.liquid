{%- comment -%}
  Heading and description on the left, collection tabs on the right, one
  horizontally scrollable product row per tab with a progress indicator.
  Without JS every tab renders as a plain scrollable row, so the products are
  always reachable.
{%- endcomment -%}
<div class="section{% if section.settings.background == 'surface' %} section--surface{% endif %}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width">
    <div class="tabbed__head">
      <div class="section-header__text">
        <h2 class="section-header__title h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="section-header__subtitle">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- assign tab_collection = collections[block.settings.collection] -%}
            <button
              type="button"
              class="tabs__tab"
              role="tab"
              id="Tab-{{ section.id }}-{{ forloop.index }}"
              aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-tab
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label | default: tab_collection.title | escape }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div data-tabs-root>
      {%- for block in section.blocks -%}
        {%- assign tab_collection = collections[block.settings.collection] -%}
        <div
          class="tabs__panel"
          role="tabpanel"
          id="Panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
          data-tab-panel
          {% unless forloop.first %}hidden{% endunless %}
        >
          {%- if tab_collection.products.size > 0 -%}
            <ul class="scroller" data-scroller>
              {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                <li>{% render 'product-card', product: product %}</li>
              {%- endfor -%}
            </ul>

            <div class="scroll-progress" data-scroll-progress aria-hidden="true">
              <span class="scroll-progress__thumb" data-scroll-thumb></span>
            </div>

            {%- if tab_collection.url -%}
              <div class="text-center mt-6">
                <a href="{{ tab_collection.url }}" class="button button--secondary">
                  {{ section.settings.link_label | default: 'View all' | escape }}
                </a>
              </div>
            {%- endif -%}
          {%- else -%}
            <p class="empty-state">{{ 'products.facets.no_products' | t }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tabbed products",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exclusive designs" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Styles you will not find anywhere else, built for how kids actually move." },
    { "type": "text", "id": "link_label", "label": "View all label", "default": "View all" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products per tab", "default": 8 },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "Page background" },
        { "value": "surface", "label": "Soft surface" }
      ],
      "default": "default"
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabbed products",
      "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
