{%- comment -%}
  Trust bar. On a wide screen the benefits sit in a row; on a phone four
  stacked rows eat half the viewport, so they scroll as a marquee instead.

  The item markup is captured once and reused, so the grid and the two
  marquee tracks never drift apart.
{%- endcomment -%}
{%- liquid
  assign mobile_style = section.settings.mobile_style | default: 'marquee'
  assign layout = section.settings.layout | default: 'bar'
-%}

{%- comment -%}
  Two captures of the same items: the grid carries the editor attributes so
  block selection resolves to exactly one element, the marquee copies do not.
{%- endcomment -%}
{%- capture usp_items_editable -%}
  {%- for block in section.blocks -%}
    <div class="usp" {{ block.shopify_attributes }}>
      <span class="usp__icon">{% render 'icon', icon: block.settings.icon %}</span>
      <span class="usp__body">
        <span class="usp__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}
          <span class="usp__text">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endfor -%}
{%- endcapture -%}

{%- capture usp_items -%}
  {%- for block in section.blocks -%}
    <div class="usp">
      <span class="usp__icon">{% render 'icon', icon: block.settings.icon %}</span>
      <span class="usp__body">
        <span class="usp__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.text != blank -%}
          <span class="usp__text">{{ block.settings.text | escape }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div class="usp-bar usp-bar--{{ layout }} usp-bar--m-{{ mobile_style }}">
  {%- if section.settings.divider_top != 'none' and section.settings.divider_top != blank -%}
    {% render 'section-divider', shape: section.settings.divider_top, position: 'top', color: section.settings.divider_color %}
  {%- endif -%}

  <div class="page-width usp-bar__static">
    <div class="usp-bar__grid">{{ usp_items_editable }}</div>
  </div>

  {%- if mobile_style == 'marquee' -%}
    <div class="usp-bar__marquee marquee" data-marquee data-speed="{{ section.settings.mobile_speed }}">
      {%- comment -%}Two tracks so the loop has no seam; the controller clones to fill.{%- endcomment -%}
      <div class="marquee__track" data-marquee-track>{{ usp_items }}</div>
      <div class="marquee__track" data-marquee-track aria-hidden="true">{{ usp_items }}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "bar", "label": "Dark bar" },
        { "value": "panel", "label": "Soft panel with circular icons" }
      ],
      "default": "bar"
    },
    {
      "type": "select",
      "id": "mobile_style",
      "label": "On phones",
      "options": [
        { "value": "marquee", "label": "Scrolling marquee" },
        { "value": "stack", "label": "Stacked list" }
      ],
      "default": "marquee"
    },
    {
      "type": "range",
      "id": "mobile_speed",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Marquee speed",
      "info": "Pixels per second.",
      "default": 45
    },
    { "type": "header", "content": "Decorative edge" },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Top edge",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "wave", "label": "Wave" },
        { "value": "scallop", "label": "Scallop" },
        { "value": "zigzag", "label": "Zigzag" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_color", "label": "Edge colour", "default": "#FFFFFF" }
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "shield", "label": "Quality" },
            { "value": "rupee", "label": "Payment" },
            { "value": "foot", "label": "Fit" },
            { "value": "ruler", "label": "Sizing" },
            { "value": "heart", "label": "Care" },
            { "value": "sparkle", "label": "Sparkle" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "On orders above ₹999" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders above ₹999" } },
        { "type": "usp", "settings": { "icon": "return", "title": "7-day exchange", "text": "Wrong size? Swap it free" } },
        { "type": "usp", "settings": { "icon": "rupee", "title": "Cash on delivery", "text": "Available across India" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Kid-safe materials", "text": "Non-toxic, skin friendly" } }
      ]
    }
  ]
}
{% endschema %}
