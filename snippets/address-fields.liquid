<div class="field">
  <label class="field__label" for="{{ form.id }}-first">{{ 'customer.addresses.first_name' | t }}</label>
  <input type="text" id="{{ form.id }}-first" name="address[first_name]" class="field__input" value="{{ form.first_name }}" autocomplete="given-name">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-last">{{ 'customer.addresses.last_name' | t }}</label>
  <input type="text" id="{{ form.id }}-last" name="address[last_name]" class="field__input" value="{{ form.last_name }}" autocomplete="family-name">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-company">{{ 'customer.addresses.company' | t }}</label>
  <input type="text" id="{{ form.id }}-company" name="address[company]" class="field__input" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-address1">{{ 'customer.addresses.address1' | t }}</label>
  <input type="text" id="{{ form.id }}-address1" name="address[address1]" class="field__input" value="{{ form.address1 }}" autocomplete="address-line1">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-address2">{{ 'customer.addresses.address2' | t }}</label>
  <input type="text" id="{{ form.id }}-address2" name="address[address2]" class="field__input" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-city">{{ 'customer.addresses.city' | t }}</label>
  <input type="text" id="{{ form.id }}-city" name="address[city]" class="field__input" value="{{ form.city }}" autocomplete="address-level2">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-country">{{ 'customer.addresses.country' | t }}</label>
  <select id="{{ form.id }}-country" name="address[country]" class="field__input" data-address-country data-default="{{ form.country }}" autocomplete="country">
    {{ country_option_tags }}
  </select>
</div>
<div class="field" data-address-province-wrap>
  <label class="field__label" for="{{ form.id }}-province">{{ 'customer.addresses.province' | t }}</label>
  <select id="{{ form.id }}-province" name="address[province]" class="field__input" data-address-province data-default="{{ form.province }}" autocomplete="address-level1"></select>
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-zip">{{ 'customer.addresses.zip' | t }}</label>
  <input type="text" id="{{ form.id }}-zip" name="address[zip]" class="field__input" value="{{ form.zip }}" autocomplete="postal-code">
</div>
<div class="field">
  <label class="field__label" for="{{ form.id }}-phone">{{ 'customer.addresses.phone' | t }}</label>
  <input type="tel" id="{{ form.id }}-phone" name="address[phone]" class="field__input" value="{{ form.phone }}" autocomplete="tel">
</div>
