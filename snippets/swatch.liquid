{%- comment -%}
  Renders one colour swatch for a product option value.
  Uses the merchant's uploaded swatch image if one exists in Files
  (named e.g. "sea-green.png"), then a mapped colour, then the raw value.
{%- endcomment -%}
{%- liquid
  assign key = value | downcase | strip
  assign file_name = key | handle | append: '.png'
  assign swatch_image = images[file_name]

  case key
    when 'sea green', 'seagreen'
      assign hex = '#3fb8a0'
    when 'lavender'
      assign hex = '#b9a6f2'
    when 'peach'
      assign hex = '#ffb59b'
    when 'royal blue'
      assign hex = '#2a4bd0'
    when 'navy', 'navy blue'
      assign hex = '#1b2a4a'
    when 'cyan', 'sky blue'
      assign hex = '#4cc9e8'
    when 'multicolor', 'multicolour'
      assign hex = 'conic-gradient(#ff5f9e, #ffc53d, #2ec4b6, #7c5cff, #ff5f9e)'
    when 'white & pink', 'white and pink'
      assign hex = 'linear-gradient(135deg, #ffffff 50%, #ff9ec4 50%)'
    when 'grey', 'gray'
      assign hex = '#9aa0ab'
    when 'beige', 'cream'
      assign hex = '#efe2cf'
    when 'maroon'
      assign hex = '#7b1e3a'
    when 'mustard'
      assign hex = '#e0a31c'
    when 'olive'
      assign hex = '#6b7a3a'
    else
      assign hex = key
  endcase
-%}
{%- if swatch_image != blank -%}
  <span class="swatch" style="background-image: url({{ swatch_image | image_url: width: 60 }}); background-size: cover;" title="{{ value | escape }}"></span>
{%- else -%}
  <span class="swatch" style="background: {{ hex }};" title="{{ value | escape }}"></span>
{%- endif -%}
