{%- if settings.whatsapp_float and settings.whatsapp_number != blank -%}
  {%- assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
  <a
    class="whatsapp-fab"
    href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    {% render 'icon', icon: 'whatsapp' %}
  </a>
{%- endif -%}
