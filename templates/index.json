      "settings": {
        "media_position": "left",
        "eyebrow": "Why Hopits",
        "heading": "Built for growing feet",
        "text": "<p>Kids' feet grow roughly a centimetre every few months, and they spend most of that time running. We design every pair around both facts — light enough to move in, sturdy enough to last, and priced so outgrowing them doesn't sting.</p>",
        "button_label": "Read our story",
        "button_link": "/pages/about-us",
        "background": "default",
        "ring_text": "Built for little adventurers",
        "divider_top": "none"
