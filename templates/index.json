    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "How do I pick the right size?",
            "answer": "<p>Measure your child's foot length in centimetres and use our size finder. Add 0.5 cm of growing room — if they're between sizes, always go up.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "What if the size is wrong?",
            "answer": "<p>Exchange it free within 7 days of delivery, as long as the shoes are unworn and in their original box. Just reach out and we'll arrange the pickup.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Do you offer cash on delivery?",
            "answer": "<p>Yes — cash on delivery is available on most pincodes across India.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are dispatched within 24 hours. Metro cities usually receive them in 2-4 working days, and the rest of India in 4-7.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How should I clean them?",
            "answer": "<p>Waterproof styles rinse under a tap and air dry. For everything else, wipe with a damp cloth and mild soap, then dry away from direct sunlight.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5"
      ],
      "settings": {
        "heading": "Questions parents ask",
        "subheading": "Still stuck? Message us on WhatsApp and we'll help you size up.",
        "background": "default"
      }
    },
